# Pantheon Frequency 46 — Environment template
# Copy this file to `.env.local` and fill in real values.

# ─── Lovable Cloud (Supabase) — required ──────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ─── Live feed providers — optional ───────────────────────────────────
# NASA APIs. When unset, the live-data proxy falls back to DEMO_KEY
# (rate-limited). Get one at https://api.nasa.gov/
VITE_NASA_API_KEY=

# YouTube Data API (server-side video availability checks).
# Get one at https://console.cloud.google.com/apis/credentials
VITE_YOUTUBE_API_KEY=

# NOAA SWPC base URL — defaults to https://services.swpc.noaa.gov
VITE_NOAA_BASE_URL=https://services.swpc.noaa.gov

# ─── Environment ──────────────────────────────────────────────────────
# development | staging | production
VITE_APP_ENV=development

# ─── Payments (optional, public publishable keys) ─────────────────────
VITE_PAYMENTS_CLIENT_TOKEN=
